# 示例配置 —— ./ocstack install 会自动生成真正的 .env（权限 600）
# 这里只是让你知道有哪些键，不要直接复制使用

# ---- 域名（两个都填最好；只填第一个则网关只走内部网络；都空则 IP 明文模式）----
OC_DOMAIN=oc.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
IP_MODE=false

# ---- 版本 ----
OPENCODE_VERSION=2.2.6
OPENCHAMBER_VERSION=2.7.0

# ---- OpenChamber ----
OPENCHAMBER_UI_PASSWORD=改成强密码

# ---- Sub2API 管理员（密码至少 8 位）----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=改成强密码至少8位

# ---- 数据库 ----
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=openssl-rand-hex-32
REDIS_PASSWORD=openssl-rand-hex-32

# ---- 固定密钥（至少 32 字节；删了会导致登出 + 2FA 失效）----
JWT_SECRET=openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=openssl-rand-hex-32

# ---- 模型 ----
SUB2API_MODEL=deepseek/deepseek-v4.1-flash
SUB2API_MODEL_ALIAS=deepseek-v4.1-flash
SUB2API_MODEL_NAME=DeepSeek V4.1 Flash
SUB2API_API_KEY=

# ---- 反代端口（80/443 被占用时安装器会自动改）----
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
HTTP_PORT=8080
API_HTTP_PORT=8081

# ---- 其他 ----
TZ=Asia/Shanghai
