# Sub2API 变量（install.sh 会生成 /opt/oc-stack/.env）
# 这里只是一个示例，不要直接用于生产

BIND_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release

POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
REDIS_PASSWORD=change-me-use-openssl-rand-hex-32

# 固定这两个，否则重启后所有人被登出、2FA 失效
JWT_SECRET=change-me-use-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

TZ=Asia/Shanghai
LOG_LEVEL=info
