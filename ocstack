cmd_up()       { need_env; dc up -d "$@"; }
cmd_down()     { need_env; dc down; }
# =============================================================================
# 开机自启（systemd）
#
# docker-compose 的 restart: unless-stopped 只在 Docker 守护进程活着时生效，
# 而且它不会检查容器是否真的健康。VPS 重启后如果 Docker 起得比网络晚，
# 容器可能停在异常状态。这里用一个 oneshot 单元在开机后兜底拉起。
# =============================================================================
AUTOSTART_UNIT="/etc/systemd/system/oc-stack.service"

autostart_profiles() {
  # 根据 .env 决定 compose 需要哪些 profile
  local prof=""
  [[ "$(envget GATEWAY_MODE)" != "external" ]] && prof="$prof --profile local-gw"
  [[ -n "$(envget CC_API_KEY)" ]] && prof="$prof --profile cc"
  printf '%s' "$prof"
}

cmd_autostart() {
  need_env
  local action="${1:-status}"

  case "$action" in
    enable)
      [[ $EUID -eq 0 ]] || die "需要 root：sudo ./ocstack autostart enable"

      if ! systemctl is-enabled docker >/dev/null 2>&1; then
        info "启用 Docker 开机自启"
        systemctl enable docker >/dev/null 2>&1 || warn "Docker 自启设置失败"
      fi

      local prof
      prof="$(autostart_profiles)"

      cat > "$AUTOSTART_UNIT" <<UNIT
[Unit]
Description=oc-stack (Sub2API + OpenCode + OpenChamber)
Documentation=https://github.com/kingsnakerrr/openchamber-deploy
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=${ROOT}
# 等 Docker 守护进程真正可用（最多 120 秒）
ExecStartPre=/bin/sh -c 'i=0; while [ \$i -lt 60 ]; do docker info >/dev/null 2>&1 && exit 0; sleep 2; i=\$((i+1)); done; exit 1'
ExecStart=/usr/bin/docker compose --env-file ${ENV_FILE} -f ${COMPOSE_FILE}${prof} up -d
ExecStop=/usr/bin/docker compose --env-file ${ENV_FILE} -f ${COMPOSE_FILE}${prof} down
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
UNIT

      systemctl daemon-reload
      systemctl enable oc-stack.service >/dev/null 2>&1
      ok "已设置开机自启（oc-stack.service）"
      echo
      printf '  验证：%ssudo systemctl is-enabled oc-stack%s\n' "$DIM" "$R"
      printf '  测试：%ssudo systemctl restart oc-stack && ./ocstack status%s\n' "$DIM" "$R"
      ;;

    disable)
      [[ $EUID -eq 0 ]] || die "需要 root"
      systemctl disable oc-stack.service >/dev/null 2>&1 || true
      rm -f "$AUTOSTART_UNIT"
      systemctl daemon-reload
      ok "已取消开机自启（容器仍在运行）"
      ;;

    status)
      local en docker_en
      en="$(systemctl is-enabled oc-stack.service 2>/dev/null || echo 'not-found')"
      docker_en="$(systemctl is-enabled docker 2>/dev/null || echo 'unknown')"

      head1 "开机自启"
      if [[ "$en" == "enabled" ]]; then
        printf '  oc-stack   %s● 已启用%s\n' "$GRN" "$R"
      else
        printf '  oc-stack   %s● 未启用%s\n' "$YEL" "$R"
      fi
      if [[ "$docker_en" == "enabled" ]]; then
        printf '  docker     %s● 已启用%s\n' "$GRN" "$R"
      else
        printf '  docker     %s● %s（容器不会自动恢复）%s\n' "$RED" "$docker_en" "$R"
      fi

      if [[ "$en" != "enabled" ]]; then
        echo
        printf '  %s开启：sudo ./ocstack autostart enable%s\n' "$DIM" "$R"
      fi
      ;;

    *)
      die "用法：./ocstack autostart [enable|disable|status]"
      ;;
  esac
}

cmd_restart()  { need_env; dc restart; }
cmd_logs()     { need_env; dc logs -f --tail=100 "$@"; }

cmd_status() {
  need_env
  head1 "容器"
  dc ps
  head1 "访问地址"
  local oc api
  oc="$(envget OC_DOMAIN)"; api="$(envget API_DOMAIN)"
  if [[ -n "$oc" ]]; then
    printf '  OpenChamber  %shttps://%s%s\n' "$GRN" "$oc" "$R"
  else
    printf '  OpenChamber  %shttp://<服务器IP>:%s%s（IP 模式）\n' "$YEL" "$(envget HTTP_PORT)" "$R"
  fi
  if [[ -n "$api" ]]; then
    printf '  Sub2API      %shttps://%s%s\n' "$GRN" "$api" "$R"
  else
    printf '  Sub2API      %s内部网络，未对外%s\n' "$DIM" "$R"
  fi
  head1 "证书"
  docker exec oc-caddy ls /data/caddy/certificates 2>/dev/null | head -5 || echo "  （尚未签发）"
  head1 "磁盘"
  du -sh "$ROOT"/data/* 2>/dev/null | sort -h || true
}

cmd_cert() {
  need_env
  local cert_mode
  cert_mode="$(envget CERT_MODE)"; cert_mode="${cert_mode:-caddy}"

  head1 "证书状态"

  if [[ "$cert_mode" == "acme" ]]; then
    # acme.sh 签发的证书在 /etc/oc-certs/<域名>/
    local found=0 d
    for d in /etc/oc-certs/*/; do
      [[ -f "${d}fullchain.pem" ]] || continue
      found=1
      printf '  %s%s%s\n' "$B" "$(basename "$d")" "$R"
      openssl x509 -in "${d}fullchain.pem" -noout -subject -issuer -dates 2>/dev/null | sed 's/^/    /'
      # 剩余天数
      local end epoch now days
      end="$(openssl x509 -in "${d}fullchain.pem" -noout -enddate 2>/dev/null | cut -d= -f2)"
      epoch="$(date -d "$end" +%s 2>/dev/null || echo 0)"
      now="$(date +%s)"
      if (( epoch > 0 )); then
        days=$(( (epoch - now) / 86400 ))
        if (( days > 30 )); then
          printf '    %s剩余 %d 天%s\n' "$GRN" "$days" "$R"
        else
          printf '    %s剩余 %d 天（将自动续期）%s\n' "$YEL" "$days" "$R"
        fi
      fi
      echo
    done
    (( found == 0 )) && warn "还没有签发证书（/etc/oc-certs）"

    echo
    if crontab -l 2>/dev/null | grep -q acme.sh; then
      info "自动续期：已配置（acme.sh cron，每天 03:17）"
    else
      warn "自动续期：未配置 cron，请运行 ./scripts/acme-helper.sh renew 手动续期"
    fi
    info "查看 ACme 日志：/opt/acme.sh/acme.sh --list"
  else
    docker exec oc-caddy sh -c '
      find /data/caddy/certificates -name "*.crt" 2>/dev/null | while read -r f; do
        echo "--- $f"
        openssl x509 -in "$f" -noout -subject -enddate 2>/dev/null | sed "s/^/    /"
      done
    ' || warn "无法读取证书"
    echo
    info "Caddy 会在证书到期前 30 天自动续期，无需 cron"
    info "续期日志：./ocstack logs caddy | grep -i renew"
  fi
}

cmd_upgrade() {
  need_env
  head1 "升级"
  cp "$ENV_FILE" "$ENV_FILE.bak.$(date +%s)"

  local oc_ver oc_c_ver
  oc_ver="${1:-}"
  oc_c_ver="${2:-}"

  info "检查最新版本"
  local latest_oc latest_ch
  latest_oc="$(curl -s https://registry.npmjs.org/@opencode/cli/latest | python3 -c "import json,sys;print(json.load(sys.stdin)['version'])" 2>/dev/null || true)"
  latest_ch="$(curl -s https://registry.npmjs.org/@openchamber/web/latest | python3 -c "import json,sys;print(json.load(sys.stdin)['version'])" 2>/dev/null || true)"

  [[ -n "$oc_ver" ]] || { printf '  OpenCode  当前 %s  最新 %s\n' "$(envget OPENCODE_VERSION)" "${latest_oc:-?}"; oc_ver="${latest_oc:-$(envget OPENCODE_VERSION)}"; }
  [[ -n "$oc_c_ver" ]] || { printf '  Chamber   当前 %s  最新 %s\n' "$(envget OPENCHAMBER_VERSION)" "${latest_ch:-?}"; oc_c_ver="${latest_ch:-$(envget OPENCHAMBER_VERSION)}"; }

  if [[ "$ASSUME_YES" != "true" ]] && ! ask_yn "  升级到 OpenCode $oc_ver / OpenChamber $oc_c_ver？" "y"; then
    info "已取消"; return
  fi

  setenv OPENCODE_VERSION "$oc_ver"
  setenv OPENCHAMBER_VERSION "$oc_c_ver"

  info "拉取 Sub2API / Caddy 新镜像"
  dc pull caddy sub2api postgres redis 2>&1 | tail -3

  info "重建 OpenChamber 镜像"
  dc build --no-cache openchamber 2>&1 | tail -3

  info "滚动重启"
  dc up -d 2>&1 | tail -3

  ok "升级完成"
  info "数据未动。回滚：编辑 .env 里的版本号后重跑 ./ocstack upgrade <版本>"
}

cmd_uninstall() {
  need_env
  local PURGE="false" FORCE="false"
  for a in "$@"; do
    case "$a" in
      --purge) PURGE="true" ;;
      --yes|-y) FORCE="true" ;;
    esac
  done

  warn "这会停止并删除所有容器"
  [[ "$PURGE" == "true" ]] || warn "数据目录 $ROOT/data 会保留"

  if [[ "$FORCE" != "true" ]] && ! ask_yn "  确认卸载？" "n"; then info "已取消"; return; fi

  # 先摘掉开机自启，否则重启时 systemd 会去找已经不存在的目录
  if [[ -f "$AUTOSTART_UNIT" ]]; then
    info "移除开机自启"
    systemctl disable oc-stack.service >/dev/null 2>&1 || true
    rm -f "$AUTOSTART_UNIT"
    systemctl daemon-reload 2>/dev/null || true
  fi

  info "停止容器"
  dc down --remove-orphans 2>/dev/null || true
  info "删除镜像"
  docker rmi "oc-stack/openchamber:$(envget OPENCHAMBER_VERSION)" 2>/dev/null || true
  docker rmi "oc-stack/ccproxy:$(envget CC_PROXY_VERSION 2>/dev/null || echo 0.4.1)" 2>/dev/null || true

  if [[ "$PURGE" == "true" ]]; then
    warn "删除全部数据（不可恢复）"
    if [[ "$FORCE" == "true" ]] || ask_yn "  真的要删 $ROOT/data 吗？" "n"; then
      rm -rf "$ROOT/data" "$ROOT/workspaces"
      docker volume rm oc-stack_caddy_data oc-stack_caddy_config 2>/dev/null || true
      ok "数据已删除"
    else
      info "数据保留"
    fi
  else
    ok "数据保留在 $ROOT/data"
    info "彻底删除：./ocstack uninstall --purge"
  fi
}

print_summary() {
  local tls_ok="${1:-false}"
  local oc api pw adm adm_pw gwmode gwurl
  oc="$(envget OC_DOMAIN)"; api="$(envget API_DOMAIN)"
  pw="$(envget OPENCHAMBER_UI_PASSWORD)"
  adm="$(envget ADMIN_EMAIL)"; adm_pw="$(envget ADMIN_PASSWORD)"
  gwmode="$(envget GATEWAY_MODE)"; gwmode="${gwmode:-local}"
  gwurl="$(envget SUB2API_BASE_URL)"

  local http_port api_port sub_port
  http_port="$(envget HTTP_PORT)"; http_port="${http_port:-18080}"
  api_port="$(envget API_HTTP_PORT)"; api_port="${api_port:-18081}"
  sub_port="$(envget SUB2API_LOCAL_PORT)"; sub_port="${sub_port:-18082}"

  local ip
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}' || true)"
  ip="${ip:-<服务器IP>}"

  printf '\n%s%s╭──────────────────────────────────────────────────────────╮%s\n' "$B" "$GRN" "$R"
  printf '%s%s│  安装完成                                                │%s\n' "$B" "$GRN" "$R"
  printf '%s%s╰──────────────────────────────────────────────────────────╯%s\n' "$B" "$GRN" "$R"

  local cert_mode caddy_https_port
  cert_mode="$(envget CERT_MODE)"; cert_mode="${cert_mode:-caddy}"
  caddy_https_port="$(envget CADDY_HTTPS_PORT)"; caddy_https_port="${caddy_https_port:-443}"

  printf '\n%s【OpenChamber】%s  —— 平时用这个\n' "$B" "$R"
  if [[ -n "$oc" && "$tls_ok" == "true" && "$cert_mode" == "acme" && "$caddy_https_port" != "443" ]]; then
    # acme + 高位端口：地址必须带端口号，否则打不开
    printf '   地址    %shttps://%s:%s%s\n' "$GRN" "$oc" "$caddy_https_port" "$R"
  elif [[ -n "$oc" && "$tls_ok" == "true" ]]; then
    printf '   地址    %shttps://%s%s\n' "$GRN" "$oc" "$R"
  elif [[ -n "$oc" && "$tls_ok" != "true" ]]; then
    # 证书没成功：给出现在真能打开的地址，别让人对着打不开的域名试
    printf '   地址    %shttp://%s:%s%s  %s(HTTPS 暂不可用)%s\n' \
      "$GRN" "$ip" "$http_port" "$R" "$YEL" "$R"
    printf '   %s域名 %s 已配置但证书未签发，详见上方诊断%s\n' "$DIM" "$oc" "$R"
  else
    printf '   地址    %shttp://%s:%s%s\n' "$GRN" "$ip" "$http_port" "$R"
    printf '   %s注意：IP 模式是 HTTP 明文，配好域名后重跑 ./ocstack install 即可升 HTTPS%s\n' "$DIM" "$R"
  fi
  printf '   密码    %s%s%s\n' "$B" "$pw" "$R"

  if [[ "$gwmode" == "external" ]]; then
    printf '\n%s【网关】%s  外接已有 Sub2API（地址见 .env 的 SUB2API_BASE_URL）\n' "$B" "$R"
    printf '   密钥请在原网关后台创建后，填进 OpenChamber 设置 → 提供商\n' "$DIM" "$R"
  else
    printf '\n%s【Sub2API 后台】%s  —— 填上游地址和 Key 的地方\n' "$B" "$R"
    if [[ -n "$api" && "$tls_ok" == "true" && "$cert_mode" == "acme" && "$caddy_https_port" != "443" ]]; then
      printf '   地址    %shttps://%s:%s%s\n' "$GRN" "$api" "$caddy_https_port" "$R"
    elif [[ -n "$api" && "$tls_ok" == "true" ]]; then
      printf '   地址    %shttps://%s%s\n' "$GRN" "$api" "$R"
    else
      printf '   地址    %shttp://127.0.0.1:%s%s  （需 SSH 隧道）\n' "$GRN" "$sub_port" "$R"
      printf '   隧道    %sssh -L %s:127.0.0.1:%s root@%s%s\n' "$DIM" "$sub_port" "$sub_port" "$ip" "$R"
      printf '   %s然后浏览器打开 http://127.0.0.1:%s%s\n' "$DIM" "$sub_port" "$R"
    fi
    printf '   账号    %s%s%s\n' "$B" "$adm" "$R"
    printf '   密码    %s%s%s\n' "$B" "$adm_pw" "$R"

    cat <<EOF

${B}${CYA}接下来三步${R}

  ${B}1.${R} 打开 Sub2API 后台，加一个上游账号
     分组 → 新建，平台选 OpenAI
     账号 → 添加，类型 API Key，填商家的 Base URL 和 Key
     账号 → 点「测试连接」，必须通过
     API 密钥 → 创建，绑定刚建的分组，复制 sk-...

  ${B}2.${R} 把密钥填进 OpenChamber
     设置 → 提供商 → Sub2API
     基础 URL：${DIM}${gwurl}${R}
     API 密钥：${DIM}上一步复制的 sk-...${R}
     ${DIM}（不要填商家的 key，要填 Sub2API 签发的）${R}

  ${B}3.${R} 验证
     ./ocstack verify

EOF
  fi

  cat <<EOF

${B}凭据都存在${R}  ${DIM}$ROOT/.env${R}   ${DIM}（600，记得备份）${R}

${B}常用命令${R}
  ./ocstack status        状态与证书
  ./ocstack logs caddy    证书申请日志
  ./ocstack verify        自检
  ./ocstack upgrade       升级
  ./ocstack uninstall     卸载

EOF
}

# =============================================================================
# 入口
# =============================================================================
usage() {
  sed -n '3,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="${1:-}"; shift || true
  ASSUME_YES="false"
  for a in "$@"; do [[ "$a" == "--yes" || "$a" == "-y" ]] && ASSUME_YES="true"; done

  case "$cmd" in
    install)    cmd_install "$@" ;;
    bootstrap)  cmd_bootstrap "$@" ;;
    verify)     cmd_verify ;;
    up)         cmd_up "$@" ;;
    down)       cmd_down ;;
    restart)    cmd_restart ;;
    autostart)  cmd_autostart "$@" ;;
    status)     cmd_status ;;
    logs)       cmd_logs "$@" ;;
    cert)       cmd_cert ;;
    upgrade)    cmd_upgrade "$@" ;;
    uninstall)  cmd_uninstall "$@" ;;
    ""|help|-h|--help) usage ;;
    *) die "未知命令：$cmd（./ocstack help 查看）" ;;
  esac
}

main "$@"
